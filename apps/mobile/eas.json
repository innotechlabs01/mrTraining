{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "qa": {
      "distribution": "internal",
      "developmentClient": false,
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "qa",
        "ANDROID_PACKAGE": "com.innotechlabssas.mrtraining.dev",
        "EXPO_PUBLIC_GO_API_URL": "https://mr-training-backend-fybayujyeq-uc.a.run.app",
        "EXPO_PUBLIC_WEB_URL": "https://mr-training-git-qa-innotechlabs-projects.vercel.app"
      },
      "channel": "qa"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "preview"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
