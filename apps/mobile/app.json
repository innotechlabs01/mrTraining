{
  "expo": {
    "name": "MR Training",
    "slug": "mr-training",
    "version": "0.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "mrtraining",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/withAndroidFirebaseAppDistribution",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "react-native-health-connect",
        {
          "permissions": [
            "android.permission.health.READ_HEART_RATE",
            "android.permission.health.READ_HEART_RATE_VARIABILITY",
            "android.permission.health.READ_RESTING_HEART_RATE",
            "android.permission.health.READ_SLEEP",
            "android.permission.health.READ_STEPS",
            "android.permission.health.READ_EXERCISE",
            "android.permission.health.READ_DISTANCE",
            "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
            "android.permission.health.READ_VO2_MAX",
            "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND"
          ]
        }
      ],
      [
        "react-native-ble-plx",
        {
          "bluetoothAlwaysPermission": "MR Training se conecta por Bluetooth a tu reloj (Garmin, banda de pecho) para leer tu pulso en tiempo real durante las carreras.",
          "isBackgroundEnabled": false,
          "neverForLocation": true
        }
      ],
      "expo-video",
      "expo-image",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MR Training usa tu ubicación para grabar la ruta de tus carreras.",
          "locationAlwaysAndWhenInUsePermission": "MR Training usa tu ubicación para grabar la ruta de tus carreras, incluso con la app en segundo plano.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.innotechlabssas.mrtraining.dev",
      "associatedDomains": [
        "applinks:mobile.innotechlabssas.lat"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "MR Training usa tu ubicación para mostrarte tu posición en tiempo real durante las rutas de running.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "MR Training utiliza tu ubicación incluso en segundo plano para grabar la ruta GPS, distancia, elevación y ritmo de tus carreras sin interrupciones cuando bloqueas la pantalla.",
        "NSLocationAlwaysUsageDescription": "MR Training utiliza tu ubicación en segundo plano para registrar el recorrido GPS completo de tus sesiones de running.",
        "NSCameraUsageDescription": "MR Training usa la cámara para guiar tu técnica de ejercicio con inteligencia artificial en tiempo real y grabar evidencias de desafíos.",
        "NSMicrophoneUsageDescription": "MR Training usa el micrófono para grabar tus intentos de desafío y sesiones en vivo con audio.",
        "NSPhotoLibraryUsageDescription": "MR Training necesita acceso a tu galería para que puedas subir tu foto de perfil, evidencias de desafíos y fotos de progreso físico.",
        "NSPhotoLibraryAddUsageDescription": "MR Training guarda en tu galería los resúmenes e imágenes de tus entrenamientos, rutas y logros.",
        "NSBluetoothAlwaysUsageDescription": "MR Training se conecta por Bluetooth a tu reloj (Garmin, Apple Watch o banda de pecho) para leer tu frecuencia cardíaca y métricas en tiempo real durante tus entrenamientos y carreras.",
        "NSBluetoothPeripheralUsageDescription": "MR Training utiliza Bluetooth para sincronizar sensores deportivos y dispositivos de frecuencia cardíaca durante tus sesiones.",
        "NSMotionUsageDescription": "MR Training utiliza los sensores de movimiento para medir tu cadencia, conteo de pasos y actividad física durante tus entrenamientos y carreras.",
        "NSFaceIDUsageDescription": "MR Training utiliza Face ID para autenticar y proteger el acceso seguro a tu cuenta y datos de salud.",
        "NSHealthShareUsageDescription": "MR Training lee tus datos de salud (HRV, sueño, pulso, VO2max, pasos y entrenamientos de Apple Watch) para medir tu recuperación y optimizar tu entrenamiento.",
        "NSHealthUpdateUsageDescription": "MR Training guarda tus entrenamientos, carreras y calorías activas en Apple Health.",
        "BGTaskSchedulerPermittedIdentifiers": [
          "com.innotechlabssas.mrtraining.healthsync",
          "com.innotechlabssas.mrtraining.refresh"
        ],
        "UIBackgroundModes": [
          "location",
          "bluetooth-central",
          "bluetooth-peripheral",
          "remote-notification",
          "processing",
          "fetch"
        ]
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": [],
        "com.apple.developer.healthkit.background-delivery": true
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#000000"
      },
      "package": "com.innotechlabssas.mrtraining.dev",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": {
            "scheme": "mrtraining",
            "host": "*"
          }
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": {
            "scheme": "https",
            "host": "mobile.innotechlabssas.lat",
            "pathPrefix": "/invite"
          }
        },
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": {
            "scheme": "https",
            "host": "app.mrtraining.com",
            "pathPrefix": "/invite"
          }
        }
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_VO2_MAX",
        "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND"
      ],
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "clerkPublishableKey": "pk_test_dXByaWdodC1tYXJ0ZW4tNjQuY2xlcmsuYWNjb3VudHMuZGV2JA",
      "apiBaseUrl": "https://mr-training-backend-fybayujyeq-uc.a.run.app",
      "goApiUrl": "https://mr-training-backend-fybayujyeq-uc.a.run.app",
      "eas": {
        "projectId": "ac276a6e-a4ef-41cc-96bd-a7ceed2f7c36"
      }
    },
    "owner": "innotechlabssass-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ac276a6e-a4ef-41cc-96bd-a7ceed2f7c36"
    }
  }
}
