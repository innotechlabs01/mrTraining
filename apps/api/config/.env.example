# MR Training API — Environment Configuration
# Copy this file to .env and fill in the values.

# =============================================================================
# Application
# =============================================================================
APP_ENV=development          # development | staging | production
APP_PORT=8080                # HTTP server port
APP_NAME=mr-training-api     # Application name (used in logs and health checks)

# =============================================================================
# Database (Turso / LibSQL)
# =============================================================================
DATABASE_URL=libsql://your-db-name.turso.io  # Turso connection URL (libsql:// for remote, file: for local)
TURSO_AUTH_TOKEN=your-turso-auth-token       # Turso authentication token (required for remote connections)

# =============================================================================
# Authentication (Clerk)
# =============================================================================
CLERK_SECRET_KEY=sk_live_your_clerk_secret_key         # Clerk secret key (backend)
CLERK_PUBLISHABLE_KEY=pk_live_your_clerk_publishable_key # Clerk publishable key (frontend)

# =============================================================================
# CORS
# =============================================================================
CORS_ORIGINS=*  # Comma-separated allowed origins. Use * for development.

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=info  # debug | info | warn | error
