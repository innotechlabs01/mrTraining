# MR Training — Web Environment Variables

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# PostgreSQL / Supabase Database
DATABASE_URL=postgres://user:pass@localhost:5432/mrtraining?sslmode=disable

# Go API (primary backend for business logic)
# Local dev: docker-compose publishes the API container (9090) on host port 9091.
NEXT_PUBLIC_GO_API_URL=http://127.0.0.1:9091
# Same-origin proxy mode (optional, lower latency): leave NEXT_PUBLIC_GO_API_URL
# EMPTY above and set GO_API_ORIGIN — the browser then calls /api/v1/* on this
# origin and Next proxies to the Go API (no extra DNS/TLS/preflight round-trip).
# GO_API_ORIGIN=http://127.0.0.1:9091

# Next.js API Routes (fallback for coaching dashboard features)
# Only needed if web and API are on different domains
# NEXT_PUBLIC_API_URL=

# App Configuration
NEXT_PUBLIC_APP_SCHEME=mrtraining
NEXT_PUBLIC_WEB_INVITE_URL=https://mr-training.vercel.app/invite
NEXT_PUBLIC_EXPO_GO_URL=exp://@innotechlabssas/mr-training

