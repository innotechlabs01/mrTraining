-- Name: workout_session_logs; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.workout_session_logs (
    id text NOT NULL,
    workout_id text NOT NULL,
    athlete_id text NOT NULL,
    started_at text NOT NULL,
    completed integer DEFAULT 0 NOT NULL,
    completed_at text,
    current_exercise_index integer DEFAULT 0 NOT NULL,
    duration_seconds integer DEFAULT 0 NOT NULL
);


ALTER TABLE public.workout_session_logs OWNER TO postgres;

--
-- Name: workout_set_logs; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.workout_set_logs (
    id text NOT NULL,
    session_id text NOT NULL,
    exercise_id text NOT NULL,
    set_index integer NOT NULL,
    weight_kg real,
    reps real,
    completed integer DEFAULT 0 NOT NULL,
    logged_at text NOT NULL,
    phase text DEFAULT 'work'::text NOT NULL,
    rir real,
    rpe real,
    sec integer,
    minutes real,
    speed real,
    skipped integer DEFAULT 0 NOT NULL
);


ALTER TABLE public.workout_set_logs OWNER TO postgres;

--
-- Name: workout_template_exercises; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.workout_template_exercises (
    id text NOT NULL,
    template_id text NOT NULL,
    exercise_id text NOT NULL,
    order_index integer DEFAULT 0 NOT NULL,
    sets integer DEFAULT 3 NOT NULL,
    reps_min integer DEFAULT 8 NOT NULL,
    reps_max integer DEFAULT 12 NOT NULL,
    rest_seconds integer DEFAULT 90 NOT NULL,
    rpe_target real,
    notes text,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL
);


ALTER TABLE public.workout_template_exercises OWNER TO postgres;

--
-- Name: workout_templates; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.workout_templates (
    id text NOT NULL,
    coach_id text NOT NULL,
    name text NOT NULL,
    description text,
    category text,
    difficulty_level text,
    duration_minutes integer,
    is_public boolean DEFAULT false NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL
);


ALTER TABLE public.workout_templates OWNER TO postgres;

