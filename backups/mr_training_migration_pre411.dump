--
-- Name: running_workout_assignments running_workout_assignments_sel_coach_or_athlete; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY running_workout_assignments_sel_coach_or_athlete ON public.running_workout_assignments FOR SELECT USING (((coach_id = NULLIF(current_setting('app.current_coach_id'::text, true), ''::text)) OR ((athlete_id = NULLIF(current_setting('app.current_user_id'::text, true), ''::text)) AND (EXISTS ( SELECT 1
   FROM public.coach_athlete_links cal
  WHERE ((cal.coach_id = running_workout_assignments.coach_id) AND (cal.athlete_id = NULLIF(current_setting('app.current_user_id'::text, true), ''::text)) AND (cal.status = 'active'::text)))))));


