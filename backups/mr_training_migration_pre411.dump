--

CREATE POLICY policy_athlete_favorites_delete ON public.athlete_favorites FOR DELETE USING (((athlete_id = NULLIF(current_setting('app.current_user_id'::text, true), ''::text)) OR (EXISTS ( SELECT 1
   FROM public.coach_athlete_links cal
  WHERE ((cal.athlete_id = cal.athlete_id) AND (cal.coach_id = NULLIF(current_setting('app.current_coach_id'::text, true), ''::text)) AND (cal.status = 'active'::text))))));


