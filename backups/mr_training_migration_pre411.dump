CREATE TABLE public.commission_entries (
    id text NOT NULL,
    operation_id text NOT NULL,
    relationship_id text NOT NULL,
    coach_id text NOT NULL,
    agreement_id text NOT NULL,
    agreement_version integer NOT NULL,
    base_cents integer NOT NULL,
    rate_bps integer NOT NULL,
    fixed_amount_cents integer NOT NULL,
    amount_cents integer NOT NULL,
    currency text DEFAULT 'COP'::text NOT NULL,
    status text DEFAULT 'accrued'::text NOT NULL,
    computed_at text NOT NULL,
    created_at text DEFAULT CURRENT_TIMESTAMP NOT NULL,
    CONSTRAINT commission_entries_amount_cents_check CHECK ((amount_cents >= 0)),
    CONSTRAINT commission_entries_base_cents_check CHECK ((base_cents >= 0)),
    CONSTRAINT commission_entries_currency_check CHECK ((currency = 'COP'::text)),
    CONSTRAINT commission_entries_fixed_amount_cents_check CHECK ((fixed_amount_cents >= 0)),
    CONSTRAINT commission_entries_rate_bps_check CHECK (((rate_bps >= 0) AND (rate_bps <= 100000))),
    CONSTRAINT commission_entries_status_check CHECK ((status = ANY (ARRAY['accrued'::text, 'reversed'::text])))
);


ALTER TABLE public.commission_entries OWNER TO postgres;

