--
-- Name: outbox; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.outbox (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    event_type character varying(50) NOT NULL,
    aggregate_type character varying(30) NOT NULL,
    aggregate_id character varying(255) NOT NULL,
    coach_id character varying(255),
    athlete_id character varying(255),
    payload jsonb NOT NULL,
    occurred_at timestamp with time zone DEFAULT now() NOT NULL,
    published_at timestamp with time zone,
    attempts integer DEFAULT 0 NOT NULL,
    next_retry_at timestamp with time zone DEFAULT now() NOT NULL,
    last_error text,
    status character varying(20) DEFAULT 'pending'::character varying NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    event_id uuid NOT NULL,
    locked_by character varying(255),
    locked_until timestamp with time zone
);


ALTER TABLE public.outbox OWNER TO postgres;

--
-- Name: TABLE outbox; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON TABLE public.outbox IS 'Tabla Outbox para eventos realtime transaccionales. Garantiza entrega de eventos: template.created, template.updated, assignment.created, workout.started, workout.completed. Los eventos se guardan dentro de la misma transacción PostgreSQL que la operación de negocio, por lo que el COMMIT confirma ambos o ninguno.';


--
-- Name: COLUMN outbox.attempts; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.outbox.attempts IS 'Contador de intentos de publicación, usado para calcular next_retry_at con backoff exponencial';


--
-- Name: COLUMN outbox.next_retry_at; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.outbox.next_retry_at IS 'Próximo momento programado para reintento. Se calcula como NOW() + backoff^attempts';


--
-- Name: COLUMN outbox.last_error; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.outbox.last_error IS 'Último error ocurrido durante un intento de publicación (null si el último intento fue exitoso)';


--
-- Name: COLUMN outbox.status; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.outbox.status IS 'Estado del evento: pending, processing, published, dead (failed deprecated)';


--
-- Name: COLUMN outbox.event_id; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.outbox.event_id IS 'Identificador canónico único por evento';


--
-- Name: COLUMN outbox.locked_by; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.outbox.locked_by IS 'Worker propietario del lease';


--
-- Name: COLUMN outbox.locked_until; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.outbox.locked_until IS 'Expiración del lease';


