    CONSTRAINT commission_agreements_check CHECK (((valid_to IS NULL) OR (valid_to >= valid_from))),
    CONSTRAINT commission_agreements_fixed_amount_cents_check CHECK ((fixed_amount_cents >= 0)),
    CONSTRAINT commission_agreements_rate_bps_check CHECK (((rate_bps >= 0) AND (rate_bps <= 100000))),
    CONSTRAINT commission_agreements_status_check CHECK ((status = ANY (ARRAY['proposed'::text, 'accepted'::text, 'superseded'::text, 'ended'::text])))
);


ALTER TABLE public.commission_agreements OWNER TO postgres;

--
-- Name: commission_entries; Type: TABLE; Schema: public; Owner: postgres
