# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:8080/api/v1

# PostgreSQL
DATABASE_URL=postgres://mrtraining:mrtraining@localhost:5432/mrtraining?sslmode=disable
DATABASE_MAX_CONNS=25
DATABASE_MIN_CONNS=5

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# NATS
NATS_URL=nats://localhost:4222

# S3-Compatible Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=mrtraining-media
S3_PUBLIC_URL=http://localhost:9000/mrtraining-media

# Paddle Payments (Sandbox)
PADDLE_API_KEY=pdl_sdbx_apikey_xxxxxxxxxxxx
PADDLE_WEBHOOK_SECRET=ntfset_xxxxxxxxxxxx
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=pdl_sdbx_apikey_xxxxxxxxxxxx
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
PADDLE_STARTER_PRICE_ID=pri_xxxxxxxxxxxx
PADDLE_PRO_PRICE_ID=pri_xxxxxxxxxxxx
PADDLE_ELITE_PRICE_ID=pri_xxxxxxxxxxxx

# AI / LLM
AI_PROVIDER=openai
AI_API_KEY=sk-xxxxxxxxxxxx
AI_MODEL=gpt-4o
AI_MAX_TOKENS=4096

# Auth (JWT)
JWT_SECRET=your-256-bit-jwt-secret-change-in-production
JWT_ACCESS_TOKEN_EXPIRY=3600
JWT_REFRESH_TOKEN_EXPIRY=2592000

# Monitoring
SENTRY_DSN=https://xxxxxxxxxxxx@sentry.io/xxxxxxxxxxxx
POSTHOG_API_KEY=phc_xxxxxxxxxxxx
POSTHOG_HOST=https://app.posthog.com

# Feature Flags
ENABLE_AI_WORKOUT_GENERATOR=true
ENABLE_AI_NUTRITION_PLANNER=false
ENABLE_MARKETPLACE=false
ENABLE_SOCIAL_LOGIN=true
MAINTENANCE_MODE=false
