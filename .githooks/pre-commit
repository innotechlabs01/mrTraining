#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "🔍 Running pre-commit checks..."

# 1. Database migrations (local PostgreSQL + Supabase QA)
echo "🗄 Syncing and applying database migrations (local + Supabase QA)..."
REQUIRE_LOCAL_DB="${REQUIRE_LOCAL_DB:-1}" bash "$REPO_ROOT/scripts/migrate-all.sh"

# sync-migrations.sh --fix can create SQL files; include them in this commit.
git add -- apps/api/migrations/postgres/*.sql supabase/migrations/*.sql

# 2. Changelog validation
if [ -f "$REPO_ROOT/scripts/validate-changelog.sh" ]; then
    bash "$REPO_ROOT/scripts/validate-changelog.sh"
fi

# 3. Go API quick checks
echo "📦 Checking Go API..."
cd "$REPO_ROOT/apps/api"
go mod tidy
if ! git diff --exit-code go.mod go.sum; then
    echo "❌ go.mod/go.sum not tidy. Run 'go mod tidy'"
    exit 1
fi

if ! go build ./...; then
    echo "❌ Go build failed"
    exit 1
fi

if ! go test ./internal/application/... -short; then
    echo "❌ Go tests failed"
    exit 1
fi

# 4. Web quick checks
echo "🌐 Checking Web..."
cd "$REPO_ROOT/apps/web"
if ! pnpm lint; then
    echo "❌ Lint errors found"
    exit 1
fi

if ! pnpm build; then
    echo "❌ TypeScript/Next.js build failed"
    exit 1
fi

echo "✅ All pre-commit checks passed!"
exit 0
